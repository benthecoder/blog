{
  "name": "nextjs-blog",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint",
    "lint:design": "tsx scripts/checkDesignTokens.ts",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:knowledge-map": "tsx scripts/generateKnowledgeMap.ts",
    "generate:knowledge-map-3d": "tsx scripts/generateKnowledgeMap3d.ts",
    "generate:image-meta": "tsx scripts/generateImageMeta.ts",
    "image": "tsx scripts/prepareImage.ts",
    "pr:screenshot": "tsx scripts/prScreenshot.ts",
    "prebuild": "pnpm run generate:knowledge-map",
    "postbuild": "next-sitemap",
    "generate-embeddings": "tsx scripts/generateEmbeddings.ts",
    "spotify-auth": "tsx scripts/spotifyAuth.ts",
    "backup": "sh scripts/backup/run.sh",
    "draft": "tsx scripts/draft.ts",
    "migrate:formats": "tsx scripts/migrateFormats.ts",
    "audit:apply": "tsx scripts/applyPostAudit.ts",
    "analyze-vector-db": "tsx scripts/analyzeVectorDB.ts",
    "prepare": "husky",
    "promote-images": "tsx scripts/promoteStrandedImages.ts",
    "photos:build": "sh scripts/photokit/build.sh",
    "photos:sync": "tsx scripts/syncPhotoCollections.ts",
    "check:unused": "knip",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1160.0",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@floating-ui/react": "^0.27.20",
    "@lezer/highlight": "^1.2.5",
    "@neondatabase/serverless": "^1.2.0",
    "@shikijs/themes": "4.6.0",
    "@uiw/react-codemirror": "^4.25.12",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^1.3.1",
    "cuelume": "0.2.8",
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "dotenv": "^18.0.9",
    "exifr": "^7.1.3",
    "github-slugger": "^2.0.0",
    "htmlparser2": "^12.0.0",
    "js-yaml": "5.5.0",
    "katex": "0.19.1",
    "lucide-react": "^1.64.0",
    "maplibre-gl": "^6.16.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-image-crop": "^11.1.2",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.0",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sanitize-html": "^2.18.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "shiki": "^4.6.0",
    "swr": "^2.5.1",
    "umap-js": "^1.4.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "voyageai": "^0.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@ai-sdk/google": "^4.0.108",
    "@huggingface/transformers": "^4.3.2",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-zoom": "^3.0.9",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "ai": "^7.0.157",
    "babel-plugin-react-compiler": "^1.0.0",
    "chalk": "^5.6.2",
    "husky": "^9.1.7",
    "knip": "^6.44.0",
    "lint-staged": "^17.6.0",
    "next-sitemap": "^4.2.3",
    "ora": "^10.0.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxlint",
      "prettier --write"
    ],
    "*.{js,jsx,json,css,md,mjs}": [
      "prettier --write"
    ]
  }
}
