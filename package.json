{
  "name": "nextjs-blog",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint && eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:knowledge-map": "tsx scripts/generateKnowledgeMap.ts",
    "generate:image-meta": "tsx scripts/generateImageMeta.ts",
    "image": "tsx scripts/prepareImage.ts",
    "prebuild": "pnpm run generate:knowledge-map",
    "postbuild": "next-sitemap",
    "generate-embeddings": "tsx scripts/generateEmbeddings.ts",
    "spotify-auth": "tsx scripts/spotifyAuth.ts",
    "sync-anki": "tsx scripts/syncAnki.ts",
    "backup": "sh scripts/backup/run.sh",
    "sync": "tsx scripts/syncAnki.ts",
    "draft": "tsx scripts/draft.ts",
    "analyze-vector-db": "tsx scripts/analyzeVectorDB.ts",
    "prepare": "husky",
    "promote-images": "tsx scripts/promoteStrandedImages.ts",
    "photos:build": "sh scripts/photokit/build.sh",
    "check:unused": "knip",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1085.0",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@floating-ui/react": "^0.27.19",
    "@neondatabase/serverless": "^1.1.0",
    "@shikijs/themes": "4.3.1",
    "@types/d3-force": "^3.0.10",
    "@uiw/react-codemirror": "^4.25.11",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^1.3.1",
    "cuelume": "0.2.1",
    "d3-force": "^3.0.0",
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "dotenv": "^16.4.5",
    "github-slugger": "^2.0.0",
    "js-yaml": "5.4.1",
    "katex": "0.18.2",
    "lucide-react": "^1.18.0",
    "ml-kmeans": "^6.0.0",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-image-crop": "^11.1.2",
    "react-markdown": "^9.0.1",
    "rehype-katex": "^7.0.0",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sanitize-html": "^2.18.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "shiki": "^4.3.1",
    "swr": "^2.3.6",
    "umap-js": "^1.4.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "voyageai": "^0.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@tailwindcss/typography": "^0.5.19",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-zoom": "^3.0.8",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sanitize-html": "^2.16.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "chalk": "^5.6.2",
    "eslint": "^9.18.0",
    "eslint-config-next": "16.4.0",
    "husky": "^9.1.7",
    "knip": "^6.39.0",
    "lint-staged": "^16.2.5",
    "next-sitemap": "^4.2.3",
    "ora": "^9.0.0",
    "oxlint": "1.86.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.22.4",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxlint",
      "eslint --no-warn-ignored",
      "prettier --write"
    ],
    "*.{js,jsx,json,css,md,mjs}": [
      "prettier --write"
    ]
  }
}
