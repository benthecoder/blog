# VoyageAI API Key for generating embeddings
# Get yours at: https://www.voyageai.com/
VOYAGE_AI_API_KEY=your_voyage_ai_api_key_here

# Neon PostgreSQL Database URL (main database for blog content chunks)
# Format: postgresql://user:password@host/database?sslmode=require
POSTGRES_URL=postgresql://user:password@host/database?sslmode=require

# OpenRouter API Key for cluster labeling (uses a free model)
# Get yours at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Spotify API
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Passphrase for browser sign-in, including the unlisted /tweet form
ADMIN_SECRET=

# Separate, high-entropy token for Shortcut capture (Authorization: Bearer ...)
TWEET_SECRET=

# Required in production for passphrase and thought-publishing rate limits
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
